import { type db as database } from "~/database";

type Options = {
  offset?: number,
  limit?: number,
};

export default function find{{ pascalCase modelName "singular" }}Ids(db: Omit<typeof database, "$client">, options: Options = {}) {
  const { offset, limit } = options;
  return db.query.{{ camelCase modelName "plural" }}.findMany({
    columns: {
      id: true,
    },
    orderBy: {
      createdAt: "asc",
    },
    limit,
    offset,
  });
}
