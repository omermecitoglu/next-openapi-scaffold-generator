import { sql } from "drizzle-orm";
import { bigint, boolean, char, index, integer, smallint, snakeCase, text, timestamp, uuid, varchar } from "drizzle-orm/pg-core";

export const {{ camelCase modelName "plural" }} = snakeCase.table("{{ snakeCase modelName "plural" }}", {
  id: uuid().defaultRandom().primaryKey(),
  // ...
  exampleInteger: integer().notNull().default(2147483647),
  exampleSmallInt: smallint().notNull().default(32767),
  exampleBigInt: bigint({ mode: "number" }).notNull().default(Number.MAX_SAFE_INTEGER),
  exampleBiggerInt: bigint({ mode: "bigint" }).notNull().default(0n),
  exampleBoolean: boolean().notNull().default(false),
  exampleText: text().notNull().default("Lorem ipsum dolor sit amet"),
  exampleVarchar: varchar({ length: 16 }).notNull().default("hello world"),
  examplechar: char({ length: 16 }).notNull().default("hello world "),
  // ...
  createdAt: timestamp({ mode: "string" }).notNull().defaultNow(),
  updatedAt: timestamp({ mode: "string" }).notNull().defaultNow().$onUpdate(() => sql`now()`),
}, table => [
  index().on(table.createdAt),
]);
