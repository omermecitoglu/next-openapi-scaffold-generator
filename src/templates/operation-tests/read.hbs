import { describe, expect, it, vi } from "vitest";
import { zocker } from "zocker";
import db from "~/database";
import { {{ pascalCaseSingular }}DTO } from "~/models/{{ kebabCaseSingular }}";
import get{{ pascalCaseSingular }} from "./get{{ pascalCaseSingular }}";

describe("get{{ pascalCaseSingular }}", () => {
  it("should retrieve a single {{ noCaseSingular }} by id", async () => {
    const mockData = zocker({{ pascalCaseSingular }}DTO.pick({ id: true })).generate();
    const spy = vi.spyOn(db.$client, "query").mockImplementation(() => Promise.resolve({ rows: [], rowCount: 0 }));

    await get{{ pascalCaseSingular }}(db, mockData.id);

    const [query, parameters] = spy.mock.calls[0] as unknown as [{ text: string }, string[]];
    const q = /^select (.+) from "{{ snakeCasePlural }}" "{{ snakeCasePlural }}" where "{{ snakeCasePlural }}"\."id" = \$1 limit \$2$/;
    expect(q.test(query.text)).toBe(true);
    expect(parameters).toEqual([...Object.values(mockData), 1]);

    spy.mockRestore();
  });
});
