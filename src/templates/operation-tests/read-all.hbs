import { describe, expect, it, vi } from "vitest";
import db from "~/database";
import get{{ pascalCasePlural }} from "./get{{ pascalCasePlural }}";

describe("get{{ pascalCasePlural }}", () => {
  it("should retrieve all {{ noCasePlural }} from the database", async () => {
    const spy = vi.spyOn(db.$client, "query").mockImplementation(() => Promise.resolve({ rows: [], rowCount: 0 }));

    await get{{ pascalCasePlural }}(db);

    const [query] = spy.mock.calls[0] as unknown as [{ text: string }, string[]];
    expect((/^select (.+) from "{{ snakeCasePlural }}" "{{ snakeCasePlural }}"/).test(query.text)).toBe(true);

    spy.mockRestore();
  });
});
