import { describe, expect, it } from "vitest";
import { zocker } from "zocker";
import { db } from "~/database";
import { {{ pascalCase modelName }}DTO, {{ pascalCase modelName }}PatchDTO, New{{ pascalCase modelName }}DTO } from "~/models/{{ kebabCase modelName }}";
import create{{ pascalCase modelName }} from "./create{{ pascalCase modelName }}";
import update{{ pascalCase modelName }} from "./update{{ pascalCase modelName }}";

describe("update{{ pascalCase modelName }}", () => {
  function generateMockPatch() {
    const zock = zocker({{ pascalCase modelName }}PatchDTO);
    let mock: ReturnType<typeof zock.generate>;
    do {
      mock = zock.generate();
    } while (Object.values(JSON.parse(JSON.stringify(mock))).length < 1); // because .set(patch) might throw "No values to set"
    return mock;
  }

  it("should return undefined when a non-existent {{ noCase modelName }} is requested for update", async () => {
    const mock{{ pascalCase modelName }}Id = zocker({{ pascalCase modelName }}DTO.pick({ id: true })).generate().id;
    const result = await update{{ pascalCase modelName }}(db, mock{{ pascalCase modelName }}Id, generateMockPatch());
    expect(result).toBeUndefined();
  });

  it("should update a {{ noCase modelName }} in the database", async () => {
    const created{{ pascalCase modelName }} = await create{{ pascalCase modelName }}(db, {
      ...zocker(New{{ pascalCase modelName }}DTO).generate(),
    });

    const mockPatch = generateMockPatch();
    const updated{{ pascalCase modelName }} = await update{{ pascalCase modelName }}(db, created{{ pascalCase modelName }}.id, mockPatch);

    expect(updated{{ pascalCase modelName }}).not.toBeUndefined();
    const updatedAt = Temporal.Instant.from(updated{{ pascalCase modelName }}!.updatedAt);
    const oneHourAgo = Temporal.Now.instant().subtract({ hours: 1 });
    const isNotEarlierThanOneHourAgo = Temporal.Instant.compare(updatedAt, oneHourAgo) >= 0;
    expect(isNotEarlierThanOneHourAgo).toBe(true);
  });
});
