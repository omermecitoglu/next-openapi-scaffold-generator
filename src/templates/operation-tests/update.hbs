import { describe, expect, it, vi } from "vitest";
import { zocker } from "zocker";
import db from "~/database";
import { {{ pascalCaseSingular }}PatchDTO, {{ pascalCaseSingular }}DTO } from "~/models/{{ kebabCaseSingular }}";
import update{{ pascalCaseSingular }} from "./update{{ pascalCaseSingular }}";

describe("update{{ pascalCaseSingular }}", () => {
  function generateMockPatch() {
    const zock = zocker({{ pascalCaseSingular }}PatchDTO);
    let mock: ReturnType<typeof zock.generate>;
    do {
      mock = zock.generate();
    } while (Object.values(JSON.parse(JSON.stringify(mock))).length < 1); // because .set(patch) might throw "No values to set"
    return mock;
  }

  it("should update a {{ noCaseSingular }} in the database", async () => {
    const mockData = zocker({{ pascalCaseSingular }}DTO.pick({ id: true })).generate();
    const mockPatch = generateMockPatch();
    const spy = vi.spyOn(db.$client, "query").mockImplementation(() => Promise.resolve({ rows: [], rowCount: 0 }));

    await update{{ pascalCaseSingular }}(db, mockData.id, mockPatch);

    expect(spy).toHaveBeenCalled();
    const [query, parameters] = spy.mock.calls[0] as unknown as [{ text: string }, string[]];
    const q = /^update "{{ snakeCasePlural }}" set (.+) where (.+) returning (.+)$/;
    expect(query.text).toMatch(q);
    expect(parameters).toEqual([
      ...Object.values(mockPatch).filter(p => typeof p !== "undefined"),
      mockData.id,
    ]);

    spy.mockRestore();
  });
});
