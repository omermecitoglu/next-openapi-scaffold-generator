import { describe, expect, it, vi } from "vitest";
import { zocker } from "zocker";
import db from "~/database";
import { {{ pascalCaseSingular }}DTO } from "~/models/{{ kebabCaseSingular }}";
import delete{{ pascalCaseSingular }} from "./delete{{ pascalCaseSingular }}";

describe("delete{{ pascalCaseSingular }}", () => {
  it("should delete a {{ noCaseSingular }} from the database", async () => {
    const mockData = zocker({{ pascalCaseSingular }}DTO.pick({ id: true })).generate();
    const spy = vi.spyOn(db.$client, "query").mockImplementation(() => Promise.resolve({ rows: [], rowCount: 0 }));

    await delete{{ pascalCaseSingular }}(db, mockData.id);

    const [query, parameters] = spy.mock.calls[0] as unknown as [{ text: string }, string[]];
    expect(query.text).toBe('delete from "{{ snakeCasePlural }}" where "{{ snakeCasePlural }}"."id" = $1 returning "id"');
    expect(parameters).toEqual(Object.values(mockData));

    spy.mockRestore();
  });
});
