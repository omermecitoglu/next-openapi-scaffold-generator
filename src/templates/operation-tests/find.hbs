import { describe, expect, it, vi } from "vitest";
import { db } from "~/database";
import find{{ pascalCase modelName "singular" }}Ids from "./find{{ pascalCase modelName "singular" }}Ids";

describe("find{{ pascalCase modelName "singular" }}Ids", () => {
  it("should retrieve all {{ noCase modelName "plural" }} from the database", async () => {
    const spy = vi.spyOn(db.$client, "query").mockImplementation(() => Promise.resolve({ rows: [], rowCount: 0 }));

    await find{{ pascalCase modelName "singular" }}Ids(db);

    const [query] = spy.mock.calls[0] as unknown as [{ text: string }, string[]];
    const q = /^select (.+) from "{{ snakeCase modelName "plural" }}" as "d0" order by "d0"."created_at" asc$/;
    expect(query.text).toMatch(q);

    spy.mockRestore();
  });

  it("should retrieve {{ noCase modelName "plural" }} with limit and offset", async () => {
    const spy = vi.spyOn(db.$client, "query").mockImplementation(() => Promise.resolve({ rows: [], rowCount: 0 }));

    await find{{ pascalCase modelName "singular" }}Ids(db, {
      limit: 50,
      offset: 50,
    });

    const [query, parameters] = spy.mock.calls[0] as unknown as [{ text: string }, string[]];
    const q = /^select (.+) from "{{ snakeCase modelName "plural" }}" as "d0" order by "d0"."created_at" asc limit \$1 offset \$2$/;
    expect(query.text).toMatch(q);
    expect(parameters).toEqual([50, 50]);

    spy.mockRestore();
  });

  it("should retrieve {{ noCase modelName "plural" }} with specific fields selected", async () => {
    const spy = vi.spyOn(db.$client, "query").mockImplementation(() => Promise.resolve({ rows: [], rowCount: 0 }));

    await find{{ pascalCase modelName "singular" }}Ids(db, {});

    const [query] = spy.mock.calls[0] as unknown as [{ text: string }, string[]];
    expect(query.text).toContain("select");
    expect(query.text).toContain("id");
    expect(query.text).toContain("createdAt");
    expect(query.text).toContain("from");
    expect(query.text).toContain("{{ snakeCase modelName "plural" }}");
    expect(query.text).toContain("order by");

    spy.mockRestore();
  });
});
