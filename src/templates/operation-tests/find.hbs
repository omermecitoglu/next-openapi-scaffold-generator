import { beforeEach, describe, expect, it } from "vitest";
import { zocker } from "zocker";
import { db } from "~/database";
import { {{ camelCase modelName "plural" }} } from "~/database/schema/{{ kebabCase modelName "plural" }}";
import { New{{ pascalCase modelName }}DTO } from "~/models/{{ kebabCase modelName }}";
import find{{ pascalCase modelName }}Ids from "./find{{ pascalCase modelName }}Ids";

describe("find{{ pascalCase modelName }}Ids", () => {
  beforeEach(async () => {
    const rows = Array.from({ length: 100 }, () => ({
      ...zocker(New{{ pascalCase modelName }}DTO).generate(),
    }));
    await db.insert({{ camelCase modelName "plural" }}).values(rows);
  });

  it("should retrieve all {{ noCase modelName "plural" }} from the database when no limit is specified", async () => {
    const result = await find{{ pascalCase modelName }}Ids(db);
    expect(result.length).toBe(100);
  });

  it("should retrieve a subset of {{ noCase modelName "plural" }} when limit and offset are specified", async () => {
    const result = await find{{ pascalCase modelName }}Ids(db, {
      limit: 50,
      offset: 50,
    });

    expect(result.length).toBe(50);
  });
});
