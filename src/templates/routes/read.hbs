export const { GET } = defineRoute({
  operationId: "get{{ pascalCase modelName }}",
  method: "GET",
  summary: "Get {{ noCase modelName }}",
  description: "Get a specific {{ noCase modelName }} by ID",
  tags: ["{{ capitalCase modelName "plural" }}"],
  pathParams: {{ pascalCase modelName }}DTO.pick({ id: true }),
  action: async ({ pathParams }) => {
    const {{ camelCase modelName }} = await get{{ pascalCase modelName }}(db, pathParams.id);
    if (!{{ camelCase modelName }}) {
      return Response.json({ errorCode: "{{ constantCase modelName }}_NOT_FOUND" }, { status: 404 });
    }
    return Response.json({{ camelCase modelName }});
  },
  handleErrors(errorType, issues) {
    switch (errorType) {
      case "PARSE_PATH_PARAMS":
        return Response.json({ errorCode: "{{ constantCase modelName }}_NOT_FOUND" }, { status: 404 });
      default:
        prettyPrintUnhandledError(errorType, issues);
        return Response.json({ errorCode: "UNKNOWN_ERROR" }, { status: 500 });
    }
  },
  responses: {
    200: { description: "{{ sentenceCase modelName }} found", content: {{ pascalCase modelName }}DTO },
    404: { description: "{{ sentenceCase modelName }} not found", content: z.object({ errorCode: z.literal(["{{ constantCase modelName }}_NOT_FOUND"]) }) },
    500: { description: "Internal Server Error", content: z.object({ errorCode: z.literal(["UNKNOWN_ERROR"]) }) },
  },
});
