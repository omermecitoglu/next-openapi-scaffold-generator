export const { GET } = defineRoute({
  operationId: "find{{ pascalCase modelName "singular" }}Ids",
  method: "GET",
  summary: "Find {{ noCase modelName "singular" }} IDs",
  description: "Retrieve a list of {{ noCase modelName "singular" }} IDs",
  tags: ["{{ capitalCase modelName "plural" }}"],
  queryParams: z.object({
    offset: z.int32().min(0),
    limit: z.int32().min(0),
  }),
  action: async ({ queryParams }) => {
    const [
      [total],
      items,
    ] = await Promise.all([
      db.select({ count: count() }).from({{ camelCase modelName "plural" }}),
      find{{ pascalCase modelName "singular" }}Ids(db, queryParams),
    ]);
    return Response.json({
      ids: pluck(items, "id"),
      pagination: {
        offset: queryParams.offset,
        limit: queryParams.limit,
        total: total.count,
      },
    });
  },
  handleErrors(errorType, issues) {
    switch (errorType) {
      case "PARSE_SEARCH_PARAMS":
        return Response.json({ errorCode: "BAD_REQUEST" }, { status: 400 });
      default:
        prettyPrintUnhandledError(errorType, issues);
        return Response.json({ errorCode: "UNKNOWN_ERROR" }, { status: 500 });
    }
  },
  responses: {
    200: {
      description: "Returns a list of {{ noCase modelName "singular" }} IDs",
      content: z.object({
        ids: {{ pascalCase modelName }}DTO.shape.id.array(),
        pagination: z.object({
          offset: z.int32().min(0),
          limit: z.int32().min(0),
          total: z.int(),
        }),
      }),
    },
    400: { description: "Bad Request", content: z.object({ errorCode: z.literal(["BAD_REQUEST"]) }) },
    500: { description: "Internal Server Error", content: z.object({ errorCode: z.literal(["UNKNOWN_ERROR"]) }) },
  },
});
