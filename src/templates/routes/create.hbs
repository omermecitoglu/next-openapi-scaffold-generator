export const { POST } = defineRoute({
  operationId: "create{{ pascalCase modelName }}",
  method: "POST",
  summary: "Create {{ noCase modelName }}",
  description: "Create a new {{ noCase modelName }}",
  tags: ["{{ capitalCase modelName "plural" }}"],
  requestBody: New{{ pascalCase modelName }}DTO,
  action: async ({ body }) => {
    const {{ camelCase modelName }} = await create{{ pascalCase modelName }}(db, body);
    return Response.json({{ camelCase modelName }}, { status: 201 });
  },
  handleErrors(errorType, issues) {
    switch (errorType) {
      case "PARSE_REQUEST_BODY":
        return Response.json({ errorCode: "BAD_REQUEST" }, { status: 400 });
      default:
        prettyPrintUnhandledError(errorType, issues);
        return Response.json({ errorCode: "UNKNOWN_ERROR" }, { status: 500 });
    }
  },
  responses: {
    201: { description: "{{ sentenceCase modelName }} created successfully", content: {{ pascalCase modelName }}DTO },
    400: { description: "Bad Request", content: z.object({ errorCode: z.literal(["BAD_REQUEST"]) }) },
    500: { description: "Internal Server Error", content: z.object({ errorCode: z.literal(["UNKNOWN_ERROR"]) }) },
  },
});
