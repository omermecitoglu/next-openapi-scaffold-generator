{
  "name": "@omer-x/next-openapi-scaffold-generator",
  "version": "1.0.0",
  "description": "Generates model, schema and API routes for CRUD operations",
  "keywords": [
    "next",
    "openapi",
    "scaffold",
    "generator",
    "swagger",
    "api",
    "crud",
    "schema",
    "model",
    "typescript",
    "ts",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omermecitoglu/next-openapi-scaffold-generator.git"
  },
  "bugs": {
    "url": "https://github.com/omermecitoglu/next-openapi-scaffold-generator/issues"
  },
  "homepage": "https://github.com/omermecitoglu/next-openapi-scaffold-generator#readme",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Omer Mecitoglu",
    "email": "omer.mecitoglu@gmail.com",
    "url": "https://omermecitoglu.github.io"
  },
  "license": "MIT",
  "main": "bin/index.js",
  "bin": {
    "generate-scaffold": "bin/index.js"
  },
  "files": [
    "bin/"
  ],
  "type": "module",
  "engines": {
    "node": ">=14.8.0"
  },
  "scripts": {
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run --coverage",
    "test:watch": "vitest --coverage",
    "dev": "concurrently \"tsup --watch\" \"chokidar 'src/**/*.hbs' -c 'touch src/index.ts'\"",
    "build": "tsup"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "handlebars": "^4.7.8",
    "pluralize": "^8.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@omer-x/eslint-config": "^2.2.6",
    "@types/node": "^25.0.1",
    "@types/pluralize": "^0.0.33",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^4.0.15",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "esbuild-plugin-inline-import": "^1.1.0",
    "eslint": "^9.39.1",
    "semantic-release": "^25.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
